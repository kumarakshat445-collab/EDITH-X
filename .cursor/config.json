{
  "name": "Inkloom",
  "install": "./scripts/cloud-agent-install.sh",
  "ports": [
    {
      "name": "Inkloom",
      "port": 8000
    }
  ],
  "terminals": [
    {
      "name": "Inkloom",
      "command": "source .venv/bin/activate && uvicorn inkloom.main:app --host 0.0.0.0 --port 8000 --reload",
      "description": "Inkloom brand governance app"
    }
  ]
}
