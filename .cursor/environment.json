{
  "name": "EDITH-X V2",
  "install": "./scripts/cloud-agent-install.sh",
  "ports": [
    {
      "name": "API",
      "port": 8000
    },
    {
      "name": "Frontend",
      "port": 3000
    }
  ],
  "terminals": [
    {
      "name": "Backend API",
      "command": "source .venv/bin/activate && cd backend && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
      "description": "EDITH-X V2 FastAPI backend"
    },
    {
      "name": "Frontend HUD",
      "command": "cd frontend && npm run dev",
      "description": "Next.js command center HUD"
    }
  ]
}
