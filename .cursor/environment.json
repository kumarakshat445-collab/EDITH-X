{
  "name": "HEXA-R",
  "install": "./scripts/cloud-agent-install.sh",
  "ports": [
    {
      "name": "API",
      "port": 8000
    },
    {
      "name": "Web",
      "port": 5173
    }
  ],
  "terminals": [
    {
      "name": "API",
      "command": "source .venv/bin/activate && uvicorn backend.app.main:app --host 0.0.0.0 --port 8000",
      "description": "HEXA-R FastAPI server"
    },
    {
      "name": "Web",
      "command": "cd frontend && npm run dev",
      "description": "HEXA-R IDE"
    }
  ]
}
